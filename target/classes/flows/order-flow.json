{
  "id": "order-flow",
  "name": "Order Processing Flow",
  "startNodeId": "start",
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "name": "Begin",
      "next": "validate"
    },
    {
      "id": "validate",
      "type": "task",
      "name": "Validate Order",
      "properties": {
        "validated": true,
        "orderStatus": "VALIDATED"
      },
      "next": "check-amount"
    },
    {
      "id": "check-amount",
      "type": "condition",
      "name": "Check Order Amount",
      "branches": [
        {
          "condition": "amount > 1000",
          "target": "approve-manager"
        },
        {
          "condition": "amount <= 1000",
          "target": "auto-approve"
        }
      ],
      "next": "auto-approve"
    },
    {
      "id": "approve-manager",
      "type": "task",
      "name": "Manager Approval",
      "properties": {
        "approver": "manager",
        "orderStatus": "PENDING_APPROVAL"
      },
      "next": "log-result"
    },
    {
      "id": "auto-approve",
      "type": "task",
      "name": "Auto Approve",
      "properties": {
        "approver": "system",
        "orderStatus": "APPROVED"
      },
      "next": "log-result"
    },
    {
      "id": "log-result",
      "type": "log",
      "name": "Log Result",
      "properties": {
        "message": "Order ${orderStatus} by ${approver}, amount: ${amount}"
      },
      "next": "end"
    },
    {
      "id": "end",
      "type": "end",
      "name": "Done"
    }
  ]
}
