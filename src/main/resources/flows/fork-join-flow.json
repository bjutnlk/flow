{
  "version": "2.0",
  "id": "fork-join-flow",
  "name": "Fork-Join Processing",
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "name": "Begin"
    },
    {
      "id": "prepare",
      "type": "submit_form",
      "name": "Prepare Data",
      "prevNodes": ["start"],
      "inputMappings": [
        { "name": "source", "source": "${dataSource}", "dataType": "STRING" }
      ]
    },
    {
      "id": "branch-b",
      "type": "submit_form",
      "name": "Process Branch B",
      "prevNodes": ["prepare"],
      "inputMappings": [
        { "name": "input", "source": "${prepare.receiptFile}", "dataType": "FILE" },
        { "name": "mode",  "source": "analysis",              "dataType": "STRING" }
      ]
    },
    {
      "id": "branch-d",
      "type": "submit_form",
      "name": "Process Branch D",
      "prevNodes": ["prepare"],
      "inputMappings": [
        { "name": "input", "source": "${prepare.receiptFile}", "dataType": "FILE" },
        { "name": "mode",  "source": "validation",            "dataType": "STRING" }
      ]
    },
    {
      "id": "merge",
      "type": "aggregate_file",
      "name": "Merge Results",
      "prevNodes": ["branch-b", "branch-d"],
      "inputMappings": [
        { "name": "fromB", "source": "${branch-b.receiptFile}", "dataType": "FILE" },
        { "name": "fromD", "source": "${branch-d.receiptFile}", "dataType": "FILE" }
      ]
    },
    {
      "id": "end",
      "type": "end",
      "name": "Done",
      "prevNodes": ["merge"]
    }
  ]
}
