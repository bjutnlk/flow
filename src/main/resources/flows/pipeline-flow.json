{
  "id": "pipeline-flow",
  "name": "Data Processing Pipeline",
  "startNodeId": "ingest",
  "nodes": [
    {
      "id": "ingest",
      "type": "submit_form",
      "name": "Ingest Data",
      "inputMappings": [
        { "name": "rawFile", "source": "file:raw-data-001", "dataType": "FILE" },
        { "name": "source",  "source": "${dataSource}",     "dataType": "STRING" }
      ],
      "next": "transform"
    },
    {
      "id": "transform",
      "type": "submit_form",
      "name": "Transform Data",
      "inputMappings": [
        { "name": "inputFile", "source": "${ingest.receiptFile}", "dataType": "FILE" },
        { "name": "format",    "source": "CSV",                   "dataType": "STRING" }
      ],
      "next": "validate"
    },
    {
      "id": "validate",
      "type": "submit_form",
      "name": "Validate Output",
      "inputMappings": [
        { "name": "transformedFile", "source": "${transform.receiptFile}", "dataType": "FILE" },
        { "name": "originalFile",    "source": "${ingest.receiptFile}",    "dataType": "FILE" }
      ],
      "next": "export"
    },
    {
      "id": "export",
      "type": "aggregate_file",
      "name": "Export Final Package",
      "inputMappings": [
        { "name": "validated",   "source": "${validate.receiptFile}", "dataType": "FILE" },
        { "name": "transformed", "source": "${transform.receiptFile}", "dataType": "FILE" }
      ],
      "next": "end"
    },
    {
      "id": "end",
      "type": "end",
      "name": "Done"
    }
  ]
}
