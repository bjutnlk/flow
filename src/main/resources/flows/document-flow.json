{
  "id": "document-flow",
  "name": "Document Processing Flow",
  "startNodeId": "start",
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "name": "Begin",
      "next": "submit"
    },
    {
      "id": "submit",
      "type": "submit_form",
      "name": "Submit Application Form",
      "inputMappings": [
        { "name": "applicantName", "source": "${applicantName}", "dataType": "STRING" },
        { "name": "document",      "source": "file:doc-001",     "dataType": "FILE" },
        { "name": "amount",        "source": "${amount}",        "dataType": "NUMBER" }
      ],
      "outputMappings": [
        { "name": "result",      "dataType": "STRING" },
        { "name": "receiptFile", "dataType": "FILE" }
      ],
      "next": "check-amount"
    },
    {
      "id": "check-amount",
      "type": "condition",
      "name": "Check Amount",
      "branches": [
        { "condition": "amount > 10000", "target": "aggregate" },
        { "condition": "amount <= 10000", "target": "log-result" }
      ],
      "next": "log-result"
    },
    {
      "id": "aggregate",
      "type": "aggregate_file",
      "name": "Aggregate Documents",
      "inputMappings": [
        { "name": "receipt",  "source": "${submit.receiptFile}", "dataType": "FILE" },
        { "name": "original", "source": "file:doc-001",         "dataType": "FILE" }
      ],
      "outputMappings": [
        { "name": "mergedFile", "dataType": "FILE" },
        { "name": "fileCount",  "dataType": "NUMBER" }
      ],
      "next": "log-result"
    },
    {
      "id": "log-result",
      "type": "log",
      "name": "Log Outcome",
      "properties": {
        "message": "Form ${submit.result}, applicant: ${applicantName}"
      },
      "next": "end"
    },
    {
      "id": "end",
      "type": "end",
      "name": "Done"
    }
  ]
}
